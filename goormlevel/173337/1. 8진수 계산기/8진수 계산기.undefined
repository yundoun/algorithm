// Run by Node.js
const readline = require('readline');

(async () => {
	let rl = readline.createInterface({ input: process.stdin });

	let N = ""
	let ary = [];
	let cnt = 0;
	
	for await (const line of rl) {
		if (cnt === 0 ){
			N = line;
			cnt++
		}	else{
			let sum = 0;
			// 숫자로 변환한 후 총 합을 구한다.
			sum += line.split(' ').reduce((acc, value) => acc +=Number(value), 0)

			// 이제 sum을 8진수로 바꾼다.
			console.log(sum.toString(8))
		}
		
		rl.close();
	}
	
	process.exit();
})();
